# Copy to .env.deploy and fill in. Gitignored.
# Used by scripts/deploy-local.sh.

# ── Hetzner server ──────────────────────────────────────────
SSH_HOST=                         # IP or hostname of the shared server
SSH_USER=deploy
SSH_PORT=22
# Absolute path to your private key. In Git Bash use /c/Users/<you>/.ssh/<key>
SSH_KEY=

# ── GHCR (image registry) ───────────────────────────────────
IMAGE_OWNER=armanatory            # ghcr.io/<owner>/quietoffice-{backend,frontend}
GHCR_PAT=                         # PAT with write:packages

# ── Runtime keys ────────────────────────────────────────────
# QS_ACCESS_KEY, QS_SECRET_KEY, QS_HOST and OPENAI_API_KEY are taken from the
# repository-root .env and forwarded to /srv/quietoffice/.env on each deploy.
# Set one here only if the server should use a different value.
# QS_ACCESS_KEY=
# QS_SECRET_KEY=
